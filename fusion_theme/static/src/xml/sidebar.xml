<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="fusion_theme.Sidebar">
        <aside t-if="!ui.isSmall" class="fx-sidebar" t-att-class="{'is-collapsed': isCollapsed}" aria-label="Applications">
            <div class="fx-side-head">
                <a class="fx-brand" href="/odoo" title="Home">
                    <span class="fx-brand-logo"><img t-att-src="logoUrl" alt="Company logo"/></span>
                </a>
            </div>

            <div class="fx-side-search" t-if="showSearch">
                <i class="fa fa-search" aria-hidden="true"/>
                <input type="search" t-ref="search" t-model="state.query" t-on-keydown="onSearchKeydown"
                       placeholder="Search apps" aria-label="Search apps" autocomplete="off"/>
            </div>

            <nav class="fx-side-nav" t-ref="nav" t-on-keydown="onNavKeydown" aria-label="Apps">
                <t t-if="pinnedApps.length">
                    <h2 class="fx-side-label">Pinned</h2>
                    <ul class="fx-side-list">
                        <t t-foreach="pinnedApps" t-as="app" t-key="app.id">
                            <t t-call="fusion_theme.SidebarItem"/>
                        </t>
                    </ul>
                </t>
                <t t-if="listedApps.length">
                    <h2 class="fx-side-label" t-esc="listLabel"/>
                    <ul class="fx-side-list">
                        <t t-foreach="listedApps" t-as="app" t-key="app.id">
                            <t t-call="fusion_theme.SidebarItem"/>
                        </t>
                    </ul>
                </t>
                <div t-if="!listedApps.length and !pinnedApps.length" class="fx-side-empty">
                    No app matches "<t t-esc="state.query"/>".
                </div>
            </nav>

            <div class="fx-side-foot">
                <button type="button" class="fx-collapse" t-on-click="() => fusion.toggleSidebar()"
                        t-att-aria-label="isCollapsed ? 'Expand sidebar' : 'Collapse sidebar'"
                        t-att-data-tooltip="isCollapsed ? 'Expand sidebar' : false" data-tooltip-position="right">
                    <span class="fx-collapse-icon"><i class="fa fa-angle-double-left" aria-hidden="true"/></span>
                    <span class="fx-collapse-label">Collapse</span>
                </button>
            </div>
        </aside>
    </t>

    <t t-name="fusion_theme.SidebarItem">
        <li class="fx-app-item" t-att-class="{'is-active': isActive(app), 'is-pinned': isPinned(app)}">
            <a class="fx-app" t-att-href="href(app)"
               t-att-aria-current="isActive(app) ? 'page' : false"
               t-att-data-menu-xmlid="app.xmlid"
               t-att-data-tooltip="isCollapsed ? app.name : false" data-tooltip-position="right"
               t-on-click="(ev) => this.open(ev, app)">
                <span class="fx-tile" t-att-class="{'is-letter': showLetter(app)}" t-att-style="tileStyle(app)">
                    <img t-if="iconMode === 'original' and app.webIconData" t-att-src="app.webIconData" alt=""/>
                    <svg t-elif="iconMode === 'outline' or iconMode === 'tile'" class="fx-glyph" viewBox="0 0 24 24" aria-hidden="true">
                        <path t-foreach="glyph(app)" t-as="d" t-key="d_index" t-att-d="d"/>
                    </svg>
                    <t t-else="" t-esc="initial(app)"/>
                </span>
                <span class="fx-app-name" t-esc="app.name"/>
            </a>
            <button type="button" class="fx-pin" t-att-aria-pressed="isPinned(app) ? 'true' : 'false'"
                    t-att-title="isPinned(app) ? 'Unpin app' : 'Pin app to top'"
                    t-att-aria-label="isPinned(app) ? 'Unpin ' + app.name : 'Pin ' + app.name"
                    t-on-click.stop.prevent="() => this.togglePin(app)">
                <i class="fa fa-thumb-tack" aria-hidden="true"/>
            </button>
        </li>
    </t>

</templates>
